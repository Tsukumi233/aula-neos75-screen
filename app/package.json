{
  "name": "neos75-screen-app",
  "productName": "Neos75 屏幕",
  "version": "0.3.2",
  "private": true,
  "description": "AULA Neos75 键盘屏幕桌面端（个人使用）",
  "author": "Neos75 Screen",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "fake": "electron . --fake",
    "shots": "electron . --fake --shots=screenshots",
    "dist": "electron-builder --win nsis",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "misans": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.neos75screen",
    "productName": "Neos75 屏幕",
    "executableName": "Neos75Screen",
    "copyright": "个人使用",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/misans/lib/Normal/**/*",
      "node_modules/misans/package.json",
      "!node_modules/misans/lib/{Arabic,ArabicUI,Devanagari,Gurmukhi,Khmer,Lao,Latin,Myanmar,TC,Thai,Tibetan}/**/*"
    ],
    "extraResources": [
      {
        "from": "build/resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neos75 屏幕",
      "uninstallDisplayName": "Neos75 屏幕",
      "artifactName": "Neos75Screen-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "include": "installer.nsh"
    },
    "compression": "maximum"
  }
}
